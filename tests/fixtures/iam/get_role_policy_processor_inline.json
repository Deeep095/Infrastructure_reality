{
  "RoleName": "processor_role",
  "PolicyName": "processor-inline",
  "PolicyDocument": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "ReadDataLake",
        "Effect": "Allow",
        "Action": ["s3:GetObject", "s3:ListBucket"],
        "Resource": ["arn:aws:s3:::data-lake", "arn:aws:s3:::data-lake/*"]
      },
      {
        "Sid": "NoDelete",
        "Effect": "Deny",
        "Action": "s3:DeleteObject",
        "Resource": "arn:aws:s3:::data-lake/*"
      }
    ]
  }
}
